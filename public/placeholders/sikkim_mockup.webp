<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 800 500" width="100%" height="100%">
  <rect width="800" height="500" rx="24" fill="#121829" />
  <rect x="30" y="30" width="740" height="440" rx="16" fill="#1B2340" stroke="#FF6B57" stroke-width="2" />
  <!-- UI Header -->
  <rect x="50" y="50" width="700" height="40" rx="8" fill="#25304A" />
  <circle cx="75" cy="70" r="6" fill="#FF6B57" />
  <circle cx="95" cy="70" r="6" fill="#FFC93C" />
  <circle cx="115" cy="70" r="6" fill="#4ECDC4" />
  <text x="400" y="75" font-family="JetBrains Mono, monospace" font-size="14" fill="#A9B1CC" text-anchor="middle">sikkim-tourism-gov.in/dashboard</text>
  <!-- Map Topography Simulation -->
  <path d="M 80 380 Q 200 220 350 320 T 650 180 T 720 400 Z" fill="#FF6B57" fill-opacity="0.25" stroke="#FF6B57" stroke-width="3" />
  <path d="M 120 420 Q 280 260 420 360 T 700 240 Z" fill="#4ECDC4" fill-opacity="0.2" stroke="#4ECDC4" stroke-width="3" />
  <!-- Floating Card Widgets -->
  <rect x="90" y="120" width="220" height="130" rx="12" fill="#121829" stroke="#2C3760" stroke-width="1.5" />
  <text x="110" y="150" font-family="Epilogue, sans-serif" font-weight="700" font-size="16" fill="#FF6B57">SIH '25 Champion</text>
  <text x="110" y="180" font-family="Inter, sans-serif" font-size="13" fill="#F4F1EA">1st Place / 1,200+ Teams</text>
  <text x="110" y="210" font-family="JetBrains Mono, monospace" font-size="12" fill="#4ECDC4">FastAPI • Redis • Leaflet</text>

  <rect x="340" y="120" width="370" height="230" rx="12" fill="#121829" stroke="#2C3760" stroke-width="1.5" />
  <text x="365" y="155" font-family="Epilogue, sans-serif" font-weight="700" font-size="18" fill="#F4F1EA">High-Altitude Routing Engine</text>
  <rect x="365" y="180" width="320" height="12" rx="6" fill="#FFC93C" />
  <rect x="365" y="205" width="240" height="12" rx="6" fill="#4ECDC4" />
  <rect x="365" y="230" width="280" height="12" rx="6" fill="#5B9BFF" />
</svg>
