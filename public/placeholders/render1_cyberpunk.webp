<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 600 400" width="100%" height="100%">
  <rect width="600" height="400" rx="20" fill="#0A0A14" />
  <!-- Neon Grid lines -->
  <path d="M 0 300 L 600 300 M 0 330 L 600 330 M 0 360 L 600 360 M 0 390 L 600 390" stroke="#79F3EA" stroke-opacity="0.3" stroke-width="2" />
  <path d="M 100 280 L 0 400 M 200 280 L 100 400 M 300 280 L 300 400 M 400 280 L 500 400 M 500 280 L 600 400" stroke="#FF6B57" stroke-opacity="0.3" stroke-width="2" />
  <!-- Cyber Studio Wireframe Cubes -->
  <polygon points="300,80 420,150 300,220 180,150" fill="#1B2340" stroke="#79F3EA" stroke-width="3" />
  <polygon points="180,150 300,220 300,320 180,250" fill="#121829" stroke="#FF6B57" stroke-width="3" />
  <polygon points="420,150 300,220 300,320 420,250" fill="#25304A" stroke="#FFC93C" stroke-width="3" />
  <text x="300" y="375" font-family="JetBrains Mono" font-weight="700" font-size="14" fill="#79F3EA" text-anchor="middle">Blender 4.2 Cycles Render • Cyber Studio</text>
</svg>
