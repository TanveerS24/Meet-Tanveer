<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 600 400" width="100%" height="100%">
  <rect width="600" height="400" rx="20" fill="#0F1C2E" />
  <!-- Medical AR HUD Elements -->
  <circle cx="300" cy="200" r="140" fill="none" stroke="#4ECDC4" stroke-width="2" stroke-dasharray="10 8" />
  <circle cx="300" cy="200" r="100" fill="none" stroke="#5B9BFF" stroke-width="1.5" />
  <!-- Floating Diagnostic Cards -->
  <rect x="80" y="80" width="160" height="90" rx="10" fill="#142032" fill-opacity="0.8" stroke="#79F3EA" stroke-width="1.5" />
  <text x="95" y="110" font-family="JetBrains Mono" font-size="12" fill="#79F3EA">Patient Volumetric</text>
  <text x="95" y="135" font-family="Inter" font-weight="700" font-size="16" fill="#FFFFFF">3D Spine AR</text>

  <rect x="360" y="240" width="170" height="90" rx="10" fill="#142032" fill-opacity="0.8" stroke="#FF6B57" stroke-width="1.5" />
  <text x="375" y="270" font-family="JetBrains Mono" font-size="12" fill="#FF6B57">Roche AR HUD</text>
  <text x="375" y="295" font-family="Inter" font-weight="700" font-size="16" fill="#FFFFFF">Hands-free Unity</text>
</svg>
