<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 800 500" width="100%" height="100%">
  <rect width="800" height="500" rx="24" fill="#0F1C2E" />
  <rect x="30" y="30" width="740" height="440" rx="16" fill="#142032" stroke="#4ECDC4" stroke-width="2" />
  <!-- Code & AST split screen -->
  <rect x="50" y="60" width="340" height="380" rx="12" fill="#071426" stroke="#293549" />
  <text x="70" y="95" font-family="JetBrains Mono, monospace" font-size="14" fill="#4AE176">function parseAST(code) {</text>
  <text x="90" y="125" font-family="JetBrains Mono, monospace" font-size="14" fill="#B5C7EA">  const tree = compile(code);</text>
  <text x="90" y="155" font-family="JetBrains Mono, monospace" font-size="14" fill="#FFB690">  return renderWebGL(tree);</text>
  <text x="70" y="185" font-family="JetBrains Mono, monospace" font-size="14" fill="#4AE176">}</text>
  <!-- AST Visual Nodes -->
  <circle cx="580" cy="120" r="28" fill="#4ECDC4" />
  <text x="580" y="126" font-family="JetBrains Mono" font-weight="700" font-size="14" fill="#003915" text-anchor="middle">Program</text>
  <line x1="560" y1="145" x2="490" y2="210" stroke="#4ECDC4" stroke-width="3" />
  <line x1="600" y1="145" x2="670" y2="210" stroke="#4ECDC4" stroke-width="3" />
  <circle cx="490" cy="230" r="24" fill="#FFC93C" />
  <text x="490" y="235" font-family="JetBrains Mono" font-weight="700" font-size="12" fill="#5A4300" text-anchor="middle">FuncDecl</text>
  <circle cx="670" cy="230" r="24" fill="#FF6B57" />
  <text x="670" y="235" font-family="JetBrains Mono" font-weight="700" font-size="12" fill="#6C0000" text-anchor="middle">BlockStmt</text>
</svg>
