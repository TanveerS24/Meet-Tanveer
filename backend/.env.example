# ==========================================
# BACKEND SERVICE ENVIRONMENT VARIABLES
# ==========================================

PORT=5000
NODE_ENV=development

# Database Configuration (PostgreSQL)
POSTGRES_USER=portfolio_user
POSTGRES_PASSWORD=portfolio_secure_password_2026
POSTGRES_DB=portfolio_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql://portfolio_user:portfolio_secure_password_2026@postgres:5432/portfolio_db?schema=public

# GitHub Integration (Backend Secret Only)
GITHUB_TOKEN=ghp_your_personal_access_token_here
GITHUB_USERNAME=TanveerS24

# Security Secrets
JWT_SECRET=super_secret_enterprise_jwt_key_32_chars_min
SESSION_SECRET=super_secret_session_key_32_chars_min

# CORS Allowed Origins
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Future Ready: SMTP Credentials
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_password
SMTP_FROM=no-reply@tanveers24.dev
